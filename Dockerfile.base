# syntax=docker/dockerfile:1.4

# 이 파일은 자주 바뀌지 않는 무거운 의존성과 모델을 담는
# "베이스 이미지"를 생성하기 위한 파일입니다.

FROM redis/redis-stack-server:latest AS redis_stack

# Ollama 공식 이미지에서 GPU 지원 바이너리와 런타임 라이브러리를 복사합니다.
FROM ollama/ollama:0.12.6 AS ollama_gpu

# --- Stage 1: Builder (Python 의존성 준비) ---
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404 AS builder

RUN apt-get update && apt-get install -y git curl ca-certificates && update-ca-certificates && rm -rf /var/lib/apt/lists/*

ENV VENV_PATH=/opt/venv
RUN python3 -m venv ${VENV_PATH}
ENV PATH="${VENV_PATH}/bin:${PATH}"

WORKDIR /app
COPY ./labnote-ai-backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# --- Stage 2: Final Base Image ---
FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

# 강제 캐시 무효화를 위한 인자 (값을 변경하면 이후 레이어가 다시 빌드됨)
ARG CACHE_BUSTER=3 # 이전 값에서 1 증가

# 1. 시스템 의존성 설치 + CA 인증서 업데이트 + wget 설치
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl gpg lsb-release ca-certificates wget && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 1-a. Redis Stack 바이너리 복사
COPY --from=redis_stack /opt/redis-stack /opt/redis-stack
RUN mkdir -p /usr/lib/redis && ln -s /opt/redis-stack/lib/modules /usr/lib/redis/modules
ENV PATH="/opt/redis-stack/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/redis-stack/lib:/usr/lib/ollama:${LD_LIBRARY_PATH}"

ENV CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# 2. Ollama GPU 런타임 설치 (공식 이미지에서 복사)
COPY --from=ollama_gpu /usr/bin/ollama /usr/bin/ollama
COPY --from=ollama_gpu /usr/lib/ollama /usr/lib/ollama

RUN ollama --version && ls -la /usr/lib/ollama

# 3. Python 가상 환경 복사
ENV VENV_PATH=/opt/venv
COPY --from=builder ${VENV_PATH} ${VENV_PATH}
ENV PATH="${VENV_PATH}/bin:${PATH}"

WORKDIR /app
