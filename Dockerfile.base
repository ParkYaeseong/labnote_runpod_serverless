# syntax=docker/dockerfile:1.4

# 이 파일은 자주 바뀌지 않는 무거운 의존성과 모델을 담는
# "베이스 이미지"를 생성하기 위한 파일입니다.

# --- Stage 1: Builder (Python 의존성 준비) ---
FROM runpod/pytorch:2.1.0-cuda12.1.1-devel-ubuntu22.04 AS builder

RUN apt-get update && apt-get install -y git curl && rm -rf /var/lib/apt/lists/*

ENV VENV_PATH=/opt/venv
RUN python3 -m venv ${VENV_PATH}
ENV PATH="${VENV_PATH}/bin:${PATH}"

WORKDIR /app
COPY ./labnote-ai-backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# --- Stage 2: Final Base Image ---
FROM runpod/pytorch:2.1.0-cuda12.1.1-devel-ubuntu22.04

# 1. 시스템 의존성 설치 (Redis)
RUN apt-get update && \
    apt-get install -y curl gpg lsb-release && \
    curl -fsSL https://packages.redis.io/gpg | gpg --dearmor -o /usr/share/keyrings/redis-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/redis-archive-keyring.gpg] https://packages.redis.io/deb jammy main" | tee /etc/apt/sources.list.d/redis.list && \
    apt-get update && \
    apt-get install -y redis-stack-server && \
    rm -rf /var/lib/apt/lists/*

# 2. Ollama 설치 
RUN curl -fsSL https://ollama.com/install.sh | sh

# 3. Python 가상 환경 복사
ENV VENV_PATH=/opt/venv
COPY --from=builder ${VENV_PATH} ${VENV_PATH}
ENV PATH="${VENV_PATH}/bin:${PATH}"

# 이 이미지는 애플리케이션 코드를 포함하지 않습니다.
# 최종 이미지가 이 이미지를 기반으로 빌드될 것입니다.
WORKDIR /app

# 시작 스크립트나 CMD는 여기에 포함하지 않습니다.